---
/**
 * Gallery — cinematic strip of game screenshots on the homepage.
 *
 * Data-driven: everything comes from `home.gallery` in the locale JSON:
 *   {
 *     "badge": "Screenshots",
 *     "title": "Inside the game",
 *     "description": "Optional one-line caption under the title.",
 *     "items": [
 *       { "title": "Card caption", "image": "/images/game/shot.webp", "alt": "..." }
 *     ]
 *   }
 *
 * The component renders nothing when `items` is empty (same opt-in contract
 * as VideoSection via home.hero.videoId). The first item spans the full
 * width on ≥sm screens for a wide cinematic anchor; the rest tile 2-up.
 * Images are plain public/ paths supplied by the config/content layer —
 * zero media or game strings are hardcoded here.
 */
interface GalleryItem {
  /** Caption rendered on the gradient scrim (also the fallback alt). */
  title: string;
  /** Public image path, e.g. "/images/game/shot-1.webp". */
  image: string;
  /** Meaningful alt text describing the actual picture. */
  alt?: string;
}

interface Props {
  badge?: string;
  title?: string;
  description?: string;
  items?: GalleryItem[];
}

const { badge, title, description, items = [] } = Astro.props;
---
{
  items.length > 0 && (
    <section class="border-b border-border">
      <div class="mx-auto max-w-7xl px-4 py-12 md:py-16">
        {badge && (
          <p class="text-sm font-semibold uppercase tracking-wider text-foreground">{badge}</p>
        )}
        {title && <h2 class="mt-1 text-2xl font-bold md:text-3xl">{title}</h2>}
        {description && (
          <p class="mt-2 max-w-2xl text-sm text-muted-foreground">{description}</p>
        )}
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {items.map((item, i) => (
            <figure
              class:list={[
                'group relative overflow-hidden rounded-xl border border-border',
                i === 0 && 'sm:col-span-2',
              ]}
            >
              <img
                src={item.image}
                alt={item.alt ?? item.title}
                loading="lazy"
                decoding="async"
                width="1200"
                height="630"
                class="aspect-[1200/630] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
              />
              <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-nav/85 via-nav/35 to-transparent px-4 pb-3 pt-10 text-sm font-semibold text-white">
                {item.title}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
